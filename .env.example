# MongoDB Connection (MongoDB Atlas or Local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/renters_management?retryWrites=true&w=majority
# For Local: mongodb://127.0.0.1:27017/renters_management
MONGODB_URI=mongodb://127.0.0.1:27017/renters_management

# Authentication Secret (Random 32+ character string)
AUTH_SECRET=super_secret_jwt_and_session_token_key_change_in_production_32char

# Next Auth / App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary Storage (Optional - falls back to local /public/uploads/ if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
